# Local demo secrets. Generate each independently; do not commit a populated .env.
JWT_SECRET=replace-with-random-32-plus-byte-secret
AUDIT_SIGNING_KEY=replace-with-independent-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-random-service-token
POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-secret
POSTGRES_APP_PASSWORD=replace-with-random-app-secret
POSTGRES_AUDIT_PASSWORD=replace-with-random-audit-writer-secret

# Optional external integrations
# GUARD_API_KEY=...
# SIEM_WEBHOOK_URL=https://your-siem-ingest.example/events
REDIS_PASSWORD=replace-with-random-redis-secret
QDRANT_API_KEY=replace-with-random-qdrant-api-key

# Production OIDC (used with docker-compose.production.yml)
# OIDC_ISSUER=https://idp.example.com/
# OIDC_AUDIENCE=aurelian-ops
# OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
